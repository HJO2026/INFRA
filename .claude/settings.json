{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(docker:*)",
      "Bash(make:*)",
      "Bash(./run-test.sh:*)",
      "Bash(./scripts/*)",
      "Bash(bash scripts/*)",
      "Bash(shellcheck:*)",
      "Bash(jq:*)",
      "Bash(curl:*)",
      "Bash(unzip:*)",
      "Bash(chmod:*)",
      "Bash(mkdir:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(./gradlew:*)",
      "Bash(git init:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(docker system prune:*)",
      "Bash(docker volume prune:*)",
      "Bash(docker image prune:*)",
      "Bash(git push:*)",
      "Bash(rm -rf /:*)",
      "Bash(sudo:*)"
    ]
  }
}
