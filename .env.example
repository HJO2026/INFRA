# 로컬 설정·비밀값 예시. `cp .env.example .env` 로 복사해서 쓴다. `.env` 는 git 에 올라가지 않는다.
# compose 는 versions.env 다음에 .env 를 읽는다 (같은 키는 .env 가 이긴다). 셸 환경변수가 그보다 더 우선이다.

# --- 앱 ---
# HS256 공유 비밀키. 32바이트 이상. 팀 전원이 같은 값을 써야 한다 (k6 가 같은 키로 토큰을 서명한다).
# 비워 두면 compose 기본값(개발용)이 쓰이고, 그 값으로 만든 토큰만 통과한다.
JWT_SECRET=

# 앱 이미지 태그. make build-app 이 이 태그로 빌드한다
APP_IMAGE=hjo-app:dev
# 앱 레포 경로 (make build-app 이 여기의 Dockerfile 로 빌드한다)
APP_DIR=../APP

# JVM 옵션. 값을 주면 앱 이미지 기본값을 통째로 대체하므로 G1·GC 로그 옵션도 함께 적는다
JAVA_OPTS=-Xms1g -Xmx1g -XX:+UseG1GC -XX:ActiveProcessorCount=4 -Xlog:gc*:file=/logs/gc.log:time,uptime

# 실험 노브 (앱 환경변수 표 참고)
DB_POOL_SIZE=10
VIRTUAL_THREADS_ENABLED=false

# compose healthcheck 가 칠 경로. 기본은 /actuator/health.
# 앱에서 management.endpoint.health.probes.enabled 를 켰다면 아래로 바꾼다
#APP_HEALTH_PATH=/actuator/health/readiness

# --- 호스트 포트 (충돌할 때만) ---
#APP_HOST_PORT=8080
#PG_HOST_PORT=15432
#PROM_HOST_PORT=9090
#GRAFANA_HOST_PORT=3000

# --- cAdvisor 마운트 (자원 패널이 빌 때만) ---
# make check-targets 가 "컨테이너별 지표를 못 내고 있다" 고 하면 이 두 경로가 플랫폼과 안 맞는 것이다.
# Docker 데몬이 도는 곳(Docker Desktop 이면 그 VM) 기준 경로를 넣는다.
#CADVISOR_DOCKER_ROOT=/var/lib/docker
#CADVISOR_CONTAINERD_SOCK=/run/containerd/containerd.sock

# --- 측정 값 덮어쓰기 (bench.config.yml 기본값 대신) ---
#RATE=50
#WARMUP_SECONDS=30
#STEADY_SECONDS=60
#COOLDOWN_SECONDS=60
